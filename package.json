{
  "name": "endurance-route-planner",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @endurance-route-planner/web",
    "dev:web": "npm run dev --workspace @endurance-route-planner/web",
    "dev:hosted": "npm run dev --workspace @endurance-route-planner/web -- --mode hosted",
    "dev:api": "npm run start:dev --workspace @endurance-route-planner/api",
    "build": "npm run build --workspace @endurance-route-planner/web && npm run build --workspace @endurance-route-planner/api",
    "build:web": "npm run build --workspace @endurance-route-planner/web",
    "build:api": "npm run build --workspace @endurance-route-planner/api",
    "typecheck": "npm run typecheck --workspace @endurance-route-planner/web && npm run typecheck --workspace @endurance-route-planner/api",
    "format": "prettier --write \"**/*.{ts,vue,css,md,json,html}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,md,json,html}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
